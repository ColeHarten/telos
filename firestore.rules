rules_version = '2';

// Deploy from the repo: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Fields whose values differ between the stored doc and the write.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Absent, null, or a string no longer than maxSize.
    function optionalText(data, field, maxSize) {
      return data.get(field, null) == null
        || (data[field] is string && data[field].size() <= maxSize);
    }

    // What a transaction may hold after a browser edit. A transfer needs a
    // destination, and never the transaction's own account.
    function validTransactionEdits(data, stored) {
      return (data.get('categoryKind', null) == null
              || data.categoryKind in ['income', 'expense', 'transfer'])
        && (data.get('categorySource', null) == null
              || data.categorySource in ['user', 'rule', 'merchant', 'plaid'])
        && data.get('hidden', false) is bool
        && optionalText(data, 'customName', 120)
        && optionalText(data, 'notes', 1000)
        && optionalText(data, 'categoryId', 200)
        && optionalText(data, 'ruleId', 200)
        && optionalText(data, 'suggestedCategoryId', 200)
        && (data.get('categoryKind', null) != 'transfer'
              || (data.get('transferAccountId', null) is string
                  && data.transferAccountId != stored.get('accountId', null)));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // No recursive wildcard under users/{uid}: Firestore allows a request
      // if ANY matching rule allows it, so a catch-all would re-open
      // plaidItems. Every subcollection is listed; anything else is denied.

      // Encrypted Plaid access tokens and sync cursors. Admin SDK only.
      match /plaidItems/{itemId} {
        allow read, write: if false;
      }

      // Per-connection sync status, written by the server.
      match /plaidItemStatus/{itemId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Written by the sync job. The browser may change the category, your
      // name for the transaction, hiding, and notes; never what Plaid reported.
      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && changedKeys().hasOnly(['categoryKind', 'categoryId', 'transferAccountId', 'categorySource', 'ruleId',
                                    'suggestedCategoryId', 'customName', 'hidden', 'notes', 'updatedAt'])
          && validTransactionEdits(request.resource.data, resource.data);
      }

      match /accounts/{accountId} {
        allow read: if isOwner(uid);

        // The browser creates manual accounts only; linked accounts come from the server.
        allow create: if isOwner(uid)
          && request.resource.data.isManual == true
          && request.resource.data.get('plaidItemId', null) == null
          && request.resource.data.get('plaidAccountId', null) == null;

        // Plaid links, and balances on linked accounts, belong to the server.
        allow update: if isOwner(uid)
          && !changedKeys().hasAny(['isManual', 'plaidAccountId', 'plaidItemId', 'plaidInstitutionId', 'plaidInstitutionName',
                                     'plaidMask', 'plaidType', 'plaidSubtype', 'plaidName', 'plaidClosed'])
          && (resource.data.get('isManual', true) == true
              || !changedKeys().hasAny(['startingBalance', 'currentBalance', 'balanceUpdatedAt']));

        // Deleting an account also deletes its transactions, so it runs on the server.
        allow delete: if false;
      }

      // One balance per linked account per day, written by the sync job.
      match /balanceSnapshots/{snapshotId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.get('kind', 'expense') in ['income', 'expense', 'transfer']
          && request.resource.data.get('plaidCategories', []) is list;
        // The kind is fixed: transactions store it, so changing it would misstate history.
        allow update: if isOwner(uid)
          && request.resource.data.get('kind', 'expense') == resource.data.get('kind', 'expense')
          && request.resource.data.get('plaidCategories', []) is list;
      }

      match /settings/{settingsId} {
        allow read, write: if isOwner(uid);
      }

      match /budgets/{monthKey} {
        allow read, write: if isOwner(uid);
      }

      // Categorization rules. You manage them; the sync job reads them.
      match /rules/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.enabled is bool
          && request.resource.data.priority is number
          && request.resource.data.conditions is map
          && request.resource.data.actions is map;
      }

      // The category you last chose for each merchant, written when you categorize.
      match /merchantMemory/{merchantKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.categoryId is string
          && request.resource.data.streak is int
          && request.resource.data.streak > 0;
      }
    }

    // Top-level collections (rateLimits, plaidUsage) have no rule, so browsers are denied.
  }
}
